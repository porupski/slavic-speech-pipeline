{
  "_readme": [
    "Notebook and runner knobs for chapter 3. Never edit the .py; change values here.",
    "Layering: Config defaults -> 'shared' -> 'classification'/'regression' -> modes[run_mode].",
    "Every key must name a real Config field in utils_instance_train.py (typos are hard errors).",
    "Targets are preset names from the TARGETS registry; list them with available_targets().",
    "",
    "Run modes:",
    "  - test   : tiny random model, ~64 rec — plumbing only, seconds.",
    "  - demo   : real model, capped data — tangible result in 1 to 2 hours.",
    "  - full   : whole corpus, caps off — for the CLI runner in tmux.",
    "  - custom : add your own preset below; anything in the modes block works.",
    "",
    "Supported base models (set via 'model_name'):",
    "  - facebook/wav2vec2-base       (small, English pretraining)",
    "  - facebook/wav2vec2-xls-r-300m (large, multilingual — Slavic coverage)",
    "  - facebook/w2v-bert-2.0        (Meta wav2vec-BERT 2.0, best on content tasks)",
    "",
    "See supported_models.md for the full compatibility matrix."
  ],

  "run_mode": "test",

  "shared": {
    "model_name": "facebook/wav2vec2-base",
    "freeze_feature_encoder": true,

    "batch_size": 16,
    "grad_accum": 1,
    "learning_rate": 1e-5,
    "num_epochs": 2,
    "max_grad_norm": 1.0,
    "warmup_ratio": 0.10,
    "logging_steps": "auto",

    "eta_rec_per_s_guess": 40.0,

    "runs_dir": "runs",
    "models_dir": "models",

    "preprocess_batch_size": 32,
    "dataloader_num_workers": 16,
    "map_num_proc": 8,
    "max_duration_s": 15.0,

    "demo_sampling": "proportional",
    "cap_seed": 1234,
    "reserved_gpu": "2"
  },

  "classification": {
    "target": "hr_bench_v3_gender",
    "best_metric_classification": "macro_f1"
  },

  "regression": {
    "target": "hr_bench_v3_age",
    "best_metric_regression": "spearman",
    "normalize": "zscore",
    "loss_function": "mse",
    "label_scale": null
  },

  "modes": {
    "test": {
      "model_name": "hf-internal-testing/tiny-random-wav2vec2",
      "cap_train": 64, "cap_dev": 16, "cap_test": 16,
      "num_epochs": 1, "batch_size": 2, "grad_accum": 1,
      "runs_dir": "runs/test", "models_dir": "models/test"
    },
    "demo": {
      "cap_train": 20000, "cap_dev": 4000, "cap_test": 4000,
      "num_epochs": 2
    },
    "full": {
      "cap_train": null, "cap_dev": null, "cap_test": null
    },
    "custom": {
    }
  }
}
