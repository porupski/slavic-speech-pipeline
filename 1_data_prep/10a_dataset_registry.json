    "ParlaSpeech-HR-benchmark-v1": {
      "source":       "hf",
      "hf_repo":      "porupski/ParlaSpeech-HR-benchmark_v1",
      "hf_repo_type": "dataset",
      "target_dir":   "data/benchmarking/ParlaSpeech-HR-benchmark-v1",
      "allow_patterns":  ["*.jsonl", "audio/**"],
      "ignore_patterns": ["*.parquet", "data/*.parquet"],
      "size_mb":  9200,
      "is_large": true,
      "note": "ParlaSpeech-HR benchmark v1 — pre-built speaker-disjoint splits for gender / speaker-id / power-status / age (all classification). Ships with 16 kHz mono audio ready to train on. ~9 GB. Feeds 11d_prep_parlaspeech_benchmark_v1."
    },

    "ParlaSpeech-HR-benchmark-v3": {
      "source":       "hf",
      "hf_repo":      "porupski/ParlaSpeech-HR-benchmark_v3",
      "hf_repo_type": "dataset",
      "target_dir":   "data/benchmarking/ParlaSpeech-HR-benchmark-v3",
      "allow_patterns":  ["*.jsonl", "audio/**", "textgrids/**"],
      "ignore_patterns": ["*.parquet", "data/*.parquet"],
      "size_mb":  9100,
      "is_large": true,
      "note": "ParlaSpeech-HR benchmark v3 — pre-built speaker-disjoint splits for gender / speaker-id / power-status (classification) and age / orientation (regression). Ships with 16 kHz mono audio; also includes align/pause/stress TextGrids where available. ~9 GB. Default download target. Feeds 11e_prep_parlaspeech_benchmark_v3."
