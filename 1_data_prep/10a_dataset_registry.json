{
  "_readme": {
    "purpose": "Single source of truth for what 10_download_data.py can fetch. Split out so it doesn't dominate the notebook.",
    "sources": {
      "clarin": "Direct HTTP from the CLARIN.SI repository. `files` lists individual archives, each with size_mb + is_large flag.",
      "hf":     "Hugging Face Hub, via `huggingface_hub.snapshot_download`. `hf_repo` + `hf_repo_type`, plus optional `allow_patterns`/`ignore_patterns`. `size_mb`/`is_large` describe the whole snapshot."
    },
    "shorthands": "Expand to lists of registry keys — e.g. 'ParlaSpeech' → all four annotation sets.",
    "how_to_extend": "Add a new entry under `datasets`. For CLARIN sources, copy an existing CLARIN block: set `source: \"clarin\"`, `handle`, `base_url`, `target_dir`, `unpack_dir`, and a `files` list with `{name, size_mb, is_large}` per archive. For HF sources, set `source: \"hf\"`, `hf_repo`, `hf_repo_type` (usually \"dataset\"), `target_dir`, plus `allow_patterns`/`ignore_patterns` to filter what snapshot_download grabs. Add the key to a shorthand under `shorthands` if it groups with others. Note that HF datasets consumed via `load_dataset` (not raw file snapshots) belong in the prep notebooks (see 11d/11e), not here."
  },

  "shorthands": {
    "ParlaSpeech":            ["ParlaSpeech-HR", "ParlaSpeech-RS", "ParlaSpeech-PL", "ParlaSpeech-CZ"],
    "ParlaSpeech-audio":      ["ParlaSpeech-HR-audio", "ParlaSpeech-RS-audio", "ParlaSpeech-PL-audio", "ParlaSpeech-CZ-audio"]
  },

