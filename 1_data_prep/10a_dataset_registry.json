{
  "_readme": {
    "purpose": "Single source of truth for what 10_download_data.py can fetch. Split out so it doesn't dominate the notebook.",
    "sources": {
      "clarin": "Direct HTTP from the CLARIN.SI repository. `files` lists individual archives, each with size_mb + is_large flag.",
      "hf":     "Hugging Face Hub. `hf_repo` + `hf_repo_type`. `allow_patterns`/`ignore_patterns` filter what snapshot_download grabs. `size_mb`/`is_large` describe the whole snapshot."
    },
    "shorthands": "Expand to lists of registry keys — e.g. 'ParlaSpeech' → all four annotation sets."
  },

  "shorthands": {
    "ParlaSpeech":            ["ParlaSpeech-HR", "ParlaSpeech-RS", "ParlaSpeech-PL", "ParlaSpeech-CZ"],
    "ParlaSpeech-audio":      ["ParlaSpeech-HR-audio", "ParlaSpeech-RS-audio", "ParlaSpeech-PL-audio", "ParlaSpeech-CZ-audio"],
    "ParlaSpeech-benchmarks": ["ParlaSpeech-HR-benchmark-v1", "ParlaSpeech-HR-benchmark-v3"]
  },

  "datasets": {
    "ROG-Dialog": {
      "source":   "clarin",
      "handle":   "http://hdl.handle.net/11356/2073",
      "base_url": "https://www.clarin.si/repository/xmlui/bitstream/handle/11356/2073",
      "target_dir": "data/raw/ROG-Dialog",
      "unpack_dir": "data/unpacked/ROG-Dialog",
      "files": [
        {"name": "ROG-Dialog.zip",       "size_mb": 5,    "is_large": true},
        {"name": "ROG-Dialog_audio.zip", "size_mb": 1220, "is_large": true}
      ],
      "note": "Slovenian dialogue corpus — sentiment, dialogue-act, filled-pause. 25 speakers, 5.2 h, EXB/TRS/TXT. The _audio.zip (~1.2 GB) is required for audio tasks."
    },

    "ROG": {
      "source":   "clarin",
      "handle":   "http://hdl.handle.net/11356/2062",
      "base_url": "https://www.clarin.si/repository/xmlui/bitstream/handle/11356/2062",
      "target_dir": "data/raw/ROG",
      "unpack_dir": "data/unpacked/ROG",
      "files": [
        {"name": "ROG.zip",         "size_mb": 30,   "is_large": false},
        {"name": "ROG-Art.wav.zip", "size_mb": 1400, "is_large": true}
      ],
      "note": "Slovenian read-speech + arts subcorpora. ROG-Art.wav.zip (~1.4 GB) is required for audio."
    },

    "GOS": {
      "source":   "clarin",
      "handle":   "http://hdl.handle.net/11356/1863",
